{
  "Resources": {
    "StopDaily": {
      "Type": "AWS::Scheduler::Schedule",
      "Properties": {
        "ScheduleExpression": "cron(0 20 * * ? *)",
        "ScheduleExpressionTimezone": "America/Caracas",
        "FlexibleTimeWindow": {
          "Mode": "OFF"
        },
        "State": "ENABLED",
        "Target": {
          "Arn": {
            "Fn::Join": [
              "",
              [
                "arn:",
                {
                  "Ref": "AWS::Partition"
                },
                ":scheduler:::aws-sdk:rds:stopDBInstance"
              ]
            ]
          },
          "Input": "{\"DbInstanceIdentifier\":\"demo-db\"}",
          "RoleArn": {
            "Fn::GetAtt": [
              "SchedulerRole",
              "Arn"
            ]
          }
        }
      }
    },
    "StopAllDays": {
      "Type": "AWS::Scheduler::Schedule",
      "Properties": {
        "ScheduleExpression": "cron(0 21 ? * 1-7 *)",
        "ScheduleExpressionTimezone": "America/Caracas",
        "FlexibleTimeWindow": {
          "Mode": "OFF"
        },
        "State": "ENABLED",
        "Target": {
          "Arn": {
            "Fn::Join": [
              "",
              [
                "arn:",
                {
                  "Ref": "AWS::Partition"
                },
                ":scheduler:::aws-sdk:rds:stopDBInstance"
              ]
            ]
          },
          "Input": "{\"DbInstanceIdentifier\":\"demo-db\"}",
          "RoleArn": {
            "Fn::GetAtt": [
              "SchedulerRole",
              "Arn"
            ]
          }
        }
      }
    },
    "StopOk": {
      "Type": "AWS::Scheduler::Schedule",
      "Properties": {
        "ScheduleExpression": "cron(30 20 ? * MON-FRI *)",
        "ScheduleExpressionTimezone": "America/Caracas",
        "FlexibleTimeWindow": {
          "Mode": "OFF"
        },
        "State": "ENABLED",
        "Target": {
          "Arn": {
            "Fn::Join": [
              "",
              [
                "arn:",
                {
                  "Ref": "AWS::Partition"
                },
                ":scheduler:::aws-sdk:rds:stopDBInstance"
              ]
            ]
          },
          "Input": "{\"DbInstanceIdentifier\":\"demo-db\"}",
          "RoleArn": {
            "Fn::GetAtt": [
              "SchedulerRole",
              "Arn"
            ]
          }
        }
      }
    }
  }
}
