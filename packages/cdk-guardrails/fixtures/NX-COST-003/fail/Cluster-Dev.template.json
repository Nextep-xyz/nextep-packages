          {
            "Name": "containerInsights",
            "Value": "enabled"
          }
        ]
      }
    },
    "Enhanced": {
      "Type": "AWS::ECS::Cluster",
      "Properties": {
        "ClusterSettings": [
          {
            "Name": "containerInsights",
            "Value": "enhanced"
          }
        ]
      }
