{
  "Resources": {
    "Api": {
      "Type": "AWS::ECS::Service",
      "Properties": {
        "LaunchType": "FARGATE",
        "DesiredCount": 1
      }
    },
    "ApiTarget": {
      "Type": "AWS::ApplicationAutoScaling::ScalableTarget",
      "Properties": {
        "MinCapacity": 1,
        "MaxCapacity": 2,
        "ScalableDimension": "ecs:service:DesiredCount",
        "ServiceNamespace": "ecs",
        "ResourceId": {
          "Fn::Join": [
            "",
            [
              "service/demo-cluster/",
              {
                "Fn::GetAtt": [
                  "Api",
                  "Name"
                ]
              }
            ]
          ]
        }
      }
    },
    "Worker": {
      "Type": "AWS::ECS::Service",
      "Properties": {
        "LaunchType": "FARGATE",
        "DesiredCount": 1
      }
    }
  }
}
