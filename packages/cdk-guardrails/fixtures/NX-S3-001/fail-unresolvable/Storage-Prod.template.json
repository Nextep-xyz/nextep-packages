{
  "Parameters": {
    "Mode": {
      "Type": "String"
    }
  },
  "Resources": {
    "Dynamic": {
      "Type": "AWS::S3::Bucket",
      "Properties": {
        "VersioningConfiguration": {
          "Status": {
            "Ref": "Mode"
          }
        },
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": {
            "Ref": "Mode"
          },
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        }
      }
    },
    "DynamicPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {
          "Ref": "Dynamic"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Action": "s3:*",
              "Effect": "Deny",
              "Principal": {
                "AWS": "*"
              },
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": "false"
                }
              },
              "Resource": [
                {
                  "Fn::GetAtt": [
                    "Dynamic",
                    "Arn"
                  ]
                },
                {
                  "Fn::Join": [
                    "",
                    [
                      {
                        "Fn::GetAtt": [
                          "Dynamic",
                          "Arn"
                        ]
                      },
                      "/*"
                    ]
                  ]
                }
              ]
            }
          ]
        }
      }
    },
    "OpaquePolicy": {
      "Type": "AWS::S3::Bucket",
      "Properties": {
        "VersioningConfiguration": {
          "Status": "Enabled"
        },
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        }
      }
    },
    "OpaquePolicyDoc": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {
          "Ref": "OpaquePolicy"
        },
        "PolicyDocument": {
          "Fn::If": [
            "Cond",
            {
              "Statement": []
            },
            {
              "Statement": []
            }
          ]
        }
      }
    }
  }
}
