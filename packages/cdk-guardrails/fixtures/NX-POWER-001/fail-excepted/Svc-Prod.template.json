{
  "Resources": {
    "Api": {
      "Type": "AWS::ECS::Service",
      "Properties": {
        "LaunchType": "FARGATE",
        "DesiredCount": 1
      }
    },
    "ScaleTarget": {
      "Type": "AWS::ApplicationAutoScaling::ScalableTarget",
      "Properties": {
        "MinCapacity": 0,
        "MaxCapacity": 2,
        "ScalableDimension": "ecs:service:DesiredCount",
        "ServiceNamespace": "ecs",
        "ResourceId": {
          "Fn::Join": [
            "",
            [
              "service/demo-cluster/",
              {
                "Fn::GetAtt": [
                  "Api",
                  "Name"
                ]
              }
            ]
          ]
        }
      }
    },
    "Nightly": {
      "Type": "AWS::ApplicationAutoScaling::ScalableTarget",
      "Properties": {
        "MinCapacity": 1,
        "MaxCapacity": 2,
        "ScalableDimension": "ecs:service:DesiredCount",
        "ServiceNamespace": "ecs",
        "ResourceId": {
          "Fn::Join": [
            "",
            [
              "service/demo-cluster/",
              {
                "Fn::GetAtt": [
                  "Api",
                  "Name"
                ]
              }
            ]
          ]
        },
        "ScheduledActions": [
          {
            "ScheduledActionName": "PowerOff",
            "Schedule": "cron(0 20 * * ? *)",
            "Timezone": "America/Caracas",
            "ScalableTargetAction": {
              "MinCapacity": 0,
              "MaxCapacity": 0
            }
          }
        ]
      }
    }
  }
}
